{
  "expo": {
    "name": "Senior Planner",
    "slug": "senior-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seniorplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static",
      "name": "Senior Planner",
      "shortName": "Planner",
      "themeColor": "#315a46",
      "backgroundColor": "#f7f5ef"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
