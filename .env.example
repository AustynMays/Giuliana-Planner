# PostgreSQL connection string for a database you manage.
DATABASE_URL=postgresql://planner_user:password@localhost:5432/senior_planner

# Set this instead of DATABASE_URL when the runtime reserves that variable.
PLANNER_DATABASE_URL=

# Use a long random value; for example: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-secret

# The API listens on PORT (defaults to 3000).
PORT=3000
NODE_ENV=development

# Comma-separated trusted app origins; required in production.
CORS_ORIGIN=http://localhost:8081

# Public API origin used by the Expo app. For a phone, use a reachable host.
EXPO_PUBLIC_API_URL=http://localhost:3000
